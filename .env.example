# ==========================================
# OmniCare Financial - Environment Variables
# ==========================================

# ── LLM Configuration ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) The model to use via LiteLLM
LLM_MODEL=openai/gpt-4o-mini

# ── Application Environment ────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Network & CORS ─────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list or JSON array of allowed frontend URLs
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ── Frontend ───────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Authentication ─────────────────────────
# Set a strong random secret (e.g. 32+ bytes from /dev/urandom).
# This MUST be set in production; the code rejects the insecure default.
JWT_SECRET_KEY=your-secret-key-here

# ── Database ───────────────────────────────
# Host port that the omnicare-db container publishes on. Keep it in sync with the
# port in DATABASE_URL. It is 15432 rather than 5432 so it does not collide with a locally
# installed PostgreSQL or another project's database container.
POSTGRES_HOST_PORT=15432
# PostgreSQL connection (requires asyncpg driver).
DATABASE_URL=postgresql+asyncpg://omnicare:omnicare_password@localhost:15432/omnicare

# ── Test Database ────────────────────────────
# The suite deletes every row in every application table before each test, so it MUST
# NOT point at the database the running stack uses. The database name has to contain
# "test" or the run aborts.
OMNICARE_TEST_DATABASE_URL=postgresql+asyncpg://omnicare:omnicare_password@localhost:15432/omnicare_test

# ── Additional settings ──────────────────────
# Index the policy documents during API startup (default: true).
# INGEST_ON_STARTUP=true

# Embedding drainer (the worker that turns embedding_jobs rows into pgvector entries).
# EMBEDDING_DRAIN_INTERVAL_SECONDS=5
# EMBEDDING_DRAIN_BATCH_SIZE=10

# ── Embedding Model ─────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small

# ── Data Files ─────────────────────────────
# CLAIMS_FILE_PATH=./app/data/mock_claims.json
# POLICY_FILE_PATH=./app/data/sample_policy.md
